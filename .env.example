# RepoRadar 部署配置示例：复制为 .env 并填写（docker compose 自动读取）
# 不要提交真实密钥到 git。

# GitHub Token（扫描私有仓库 / 提升限流，可选）
GITHUB_TOKEN=

# OpenAI 兼容 LLM（AI 建议 / README 草稿 / AEO 探测，可选）
REPO_SEO_API_KEY=
REPO_SEO_BASE_URL=https://apihub.agnes-ai.com/v1
REPO_SEO_MODEL=agnes-2.5-flash

# 多模型 AEO 探测（逗号分隔，可选）
REPO_SEO_PROBE_MODELS=

# Google 收录核验（可选）
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
